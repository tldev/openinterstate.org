---
import BaseLayout from "../layouts/BaseLayout.astro";
import InterstateMap from "../components/InterstateMap.astro";
import { release, reachabilityRelease } from "../data/releases";
import schema from "../data/schema.json";

const tables = schema.core.tables.map((t) => [t.name, t.description.replace(/\.$/, "")]);
---

<BaseLayout
  title="OpenInterstate | Open US Interstate Highway Data"
  description="Download open US interstate highway data: 647 corridors, 96,366 exits, 109,647 linked places, and reference routes as CSV, GPX, and GeoJSON, built from OpenStreetMap."
>
  <section>
    <h1>US interstate highway data, built from OpenStreetMap</h1>
    <p class="lead">
      Directional corridors, normalized exits, linked places, and reference
      routes for the whole US interstate system, extracted from raw OSM and
      published under ODbL as dated, checksummed releases.
    </p>
  </section>

  <InterstateMap />

  <section>
    <div class="stats">
      {release.stats.map(([val, lbl]) => (
        <div>
          <div class="stat-val">{val}</div>
          <div class="stat-lbl">{lbl}</div>
        </div>
      ))}
    </div>
  </section>

  <hr />

  <section>
    <h2>Download the data</h2>
    <pre><code>curl -LO \
  {release.archiveUrl}</code></pre>
    <p>
      That's the entire dataset in a single tarball, with no signup required.
      Manifests, checksums, and lineage files live on the
      <a href="/releases">releases page</a>.
    </p>
    <p>
      Use it for trip planners, exit guides, routing experiments, or any GIS
      project that needs the interstate network without parsing a planet-scale
      OSM extract.
    </p>
    <p>
      Drive-time reachability scores ship separately:
      <a href={reachabilityRelease.githubUrl}>openinterstate-reachability {reachabilityRelease.tag}</a>
    </p>
  </section>

  <hr />

  <section>
    <h2>What's in a release</h2>
    <p>
      Each release ships these core CSV tables, plus GPX reference routes and
      GeoJSON examples. Column-level docs live on the
      <a href="/schema">schema page</a>.
    </p>
    <table>
      <thead>
        <tr>
          <th>Table</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {tables.map(([name, desc]) => (
          <tr>
            <td>{name}</td>
            <td>{desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <hr />

  <section>
    <h2>Links</h2>
    <ul class="links">
      <li><a href="https://github.com/tldev/openinterstate">Core data on GitHub</a></li>
      <li><a href="https://github.com/tldev/openinterstate-reachability">Reachability scores on GitHub</a></li>
      <li><a href="/schema">Schema</a></li>
    </ul>
  </section>
</BaseLayout>
