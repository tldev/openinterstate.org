---
import BaseLayout from "../layouts/BaseLayout.astro";
import Toc from "../components/Toc.astro";
import { release, reachabilityRelease } from "../data/releases";

const tocGroups = [
  { label: "Core", children: [{ id: release.tag, label: release.tag }] },
  { label: "Reachability", children: [{ id: reachabilityRelease.tag, label: reachabilityRelease.tag }] },
];

const artifacts = [
  [release.archiveUrl, "release archive", "CSV tables, GPX reference routes, and GeoJSON examples in one .tar.gz"],
  [release.manifestUrl, "manifest.json", "What the archive contains"],
  [release.sourceLineageUrl, "source_lineage.json", "The OSM extract this release was built from"],
  [release.checksumsUrl, "checksums.txt", "Checksums for verifying your download"],
];

const reachabilityArtifacts = [
  [reachabilityRelease.scoresUrl, "reachability.csv", "One row of drive-time scores per scored exit-place pair"],
  [reachabilityRelease.snapHintsUrl, "osrm_snap_hints.csv", "OSRM snap hints that speed up incremental scoring runs"],
];
---

<BaseLayout
  title="Download Interstate Data Releases | OpenInterstate"
  description="Dated, checksummed releases of US interstate highway data. Download CSV tables, GPX reference routes, and GeoJSON examples with full source lineage."
>
  <Toc groups={tocGroups} />

  <section>
    <h1>Releases</h1>
    <p class="lead">
      Every release is dated, checksummed, and traceable to the exact OSM
      extract it was built from.
    </p>
  </section>

  <section>
    <h2 id={release.tag}>{release.tag}</h2>
    <p>
      This is the latest release, cut {release.date} from the raw US OSM PBF
      with standalone OpenInterstate tooling.
    </p>

    <div class="stats">
      {release.stats.map(([val, lbl]) => (
        <div>
          <div class="stat-val">{val}</div>
          <div class="stat-lbl">{lbl}</div>
        </div>
      ))}
    </div>

    <pre><code>curl -LO \
  {release.archiveUrl}</code></pre>

    <table>
      <thead>
        <tr>
          <th>Artifact</th>
          <th>What it is</th>
        </tr>
      </thead>
      <tbody>
        {artifacts.map(([url, name, desc]) => (
          <tr>
            <td><a href={url}>{name}</a></td>
            <td>{desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      The same files are attached to the
      <a href={release.githubUrl}>GitHub release page</a>.
    </p>
  </section>

  <hr />

  <section>
    <h2 id={reachabilityRelease.tag}>{reachabilityRelease.tag}</h2>
    <p>
      These are drive-time reachability scores between exits and nearby
      places, cut {reachabilityRelease.date} against
      {reachabilityRelease.against} and published from the separate
      <a href="https://github.com/tldev/openinterstate-reachability">openinterstate-reachability</a>
      repo.
    </p>

    <div class="stats">
      {reachabilityRelease.stats.map(([val, lbl]) => (
        <div>
          <div class="stat-val">{val}</div>
          <div class="stat-lbl">{lbl}</div>
        </div>
      ))}
    </div>

    <pre><code>curl -LO \
  {reachabilityRelease.scoresUrl}</code></pre>

    <table>
      <thead>
        <tr>
          <th>Artifact</th>
          <th>What it is</th>
        </tr>
      </thead>
      <tbody>
        {reachabilityArtifacts.map(([url, name, desc]) => (
          <tr>
            <td><a href={url}>{name}</a></td>
            <td>{desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      The same files are attached to the
      <a href={reachabilityRelease.githubUrl}>GitHub release page</a>.
    </p>
  </section>
</BaseLayout>
