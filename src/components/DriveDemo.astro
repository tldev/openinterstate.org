---
import demo from "../data/drive-demo.json";

const exitCount = demo.exits.length;
---

<div class="drive" data-interstate={demo.interstate} data-direction={demo.direction}>
  <div class="drive-head">
    <span class="drive-route">{demo.interstate} {demo.direction}</span>
    <span class="drive-pos" id="drive-pos">1 of {exitCount.toLocaleString("en-US")} exits</span>
  </div>
  <input
    type="range"
    id="drive-range"
    class="drive-range"
    min="0"
    max={exitCount - 1}
    value="0"
    aria-label={`Position along ${demo.interstate} ${demo.direction}`}
  />
  <div class="drive-panel">
    <div class="drive-info">
      <div class="drive-exit" id="drive-exit">EXIT</div>
      <div class="drive-services" id="drive-services"></div>
    </div>
    <div class="drive-map" id="drive-map-box" role="img" aria-label="OpenStreetMap view of places reachable from this exit">
      <div class="drive-tiles" id="drive-tiles"></div>
      <svg class="drive-overlay" id="drive-overlay"></svg>
      <a class="drive-attrib" href="https://www.openstreetmap.org/copyright">&copy; OpenStreetMap</a>
    </div>
  </div>
  <div class="drive-foot">
    <button type="button" class="drive-btn" id="drive-btn">Drive</button>
    <span class="drive-src">
      data: <a href={`https://github.com/tldev/openinterstate/releases/tag/${demo.release}`}>{demo.release}</a>
      + <a href={`https://github.com/tldev/openinterstate-reachability/releases/tag/${demo.scoreRelease}`}>{demo.scoreRelease}</a>
    </span>
  </div>
</div>

<svg style="display:none" aria-hidden="true">
  <symbol id="oi-ic-gas" viewBox="0 0 24 24">
    <path d="M5 2a1 1 0 0 0-1 1v18h11V3a1 1 0 0 0-1-1H5z"/>
    <rect x="6" y="4.5" width="7" height="4.5" rx="0.5" fill="var(--bg)"/>
    <path d="M16.5 9.5V8l2.6-2.6 1.1 1.1-2.1 2.1v7.9a2.6 2.6 0 1 1-5.2 0V14h1.6v2.5a1 1 0 0 0 2 0V9.5z"/>
  </symbol>
  <symbol id="oi-ic-food" viewBox="0 0 24 24">
    <path d="M7 2h1.4v5.2h1V2h1.4v5.2h1V2h1.4v6.4a2.6 2.6 0 0 1-2 2.53L11.5 22h-2l.3-11.07a2.6 2.6 0 0 1-2-2.53V2z"/>
    <path d="M17.5 2c-1.6 2.6-2.3 5-2.3 7.1 0 1.6.7 2.7 1.8 3.2L16.6 22h2l-.3-20h-.8z"/>
  </symbol>
  <symbol id="oi-ic-lodging" viewBox="0 0 24 24">
    <path d="M2.5 5.5H4v9h16.5v-3.2a3.3 3.3 0 0 0-3.3-3.3H10v5H4v-7.5H2.5z" transform="translate(0 1.5)"/>
    <circle cx="7" cy="11.5" r="1.9"/>
    <path d="M2.5 16h1.5v3h-1.5zM20 16h1.5v3H20z"/>
    <path d="M2.5 14.5h19V16h-19z"/>
  </symbol>
  <symbol id="oi-ic-ev" viewBox="0 0 24 24">
    <path d="M13.5 2 5 13.5h5L8.5 22 17 10.5h-5L13.5 2z"/>
  </symbol>
  <symbol id="oi-ic-rest" viewBox="0 0 24 24">
    <path d="M4 8h16v2h-4.1l2.5 9h-2l-.9-3.2H8.5L7.6 19h-2l2.5-9H4V8zm6.1 2-.6 2.3h5l-.6-2.3h-3.8zM9 4h6v2H9z"/>
  </symbol>
  <symbol id="oi-ic-park" viewBox="0 0 24 24">
    <path d="M12 2 6.5 10.5h3L5 17.5h5.5V22h3v-4.5H19l-4.5-7h3L12 2z"/>
  </symbol>
  <symbol id="oi-ic-dog" viewBox="0 0 24 24">
    <circle cx="6.5" cy="9" r="2"/>
    <circle cx="12" cy="6.5" r="2"/>
    <circle cx="17.5" cy="9" r="2"/>
    <path d="M12 10.5c-3.2 0-5.8 2.4-5.8 4.9 0 1.8 1.4 2.7 2.8 2.7 1 0 2-.5 3-.5s2 .5 3 .5c1.4 0 2.8-.9 2.8-2.7 0-2.5-2.6-4.9-5.8-4.9z"/>
  </symbol>
  <symbol id="oi-ic-place" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="5"/>
  </symbol>
</svg>

<script type="application/json" id="drive-data" set:html={JSON.stringify(demo.exits)} />

<script>
  type Place = [string, string, number, number, number];
  type Exit = { n: string; name: string; ll: [number, number]; p: Place[] };

  const exits: Exit[] = JSON.parse(document.getElementById("drive-data")!.textContent!);
  const range = document.getElementById("drive-range") as HTMLInputElement;
  const pos = document.getElementById("drive-pos")!;
  const exitEl = document.getElementById("drive-exit")!;
  const services = document.getElementById("drive-services")!;
  const tilesEl = document.getElementById("drive-tiles")!;
  const overlay = document.getElementById("drive-overlay")!;
  const btn = document.getElementById("drive-btn") as HTMLButtonElement;

  const total = exits.length;
  const mapBox = document.getElementById("drive-map-box")!;
  const TILE = 256;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function exitLabel(e: Exit) {
    if (e.n) return `EXIT ${e.n}`;
    if (e.name) return e.name.toUpperCase();
    return "UNNUMBERED EXIT";
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  }

  const ICONS: Record<string, string> = {
    gas: "gas",
    food: "food",
    lodging: "lodging",
    "EV charging": "ev",
    "rest area": "rest",
    park: "park",
    "dog park": "dog",
  };
  const icon = (cat: string) => `#oi-ic-${ICONS[cat] || "place"}`;

  // Web Mercator world pixels at zoom z.
  function worldX(lon: number, z: number) {
    return ((lon + 180) / 360) * (1 << z) * TILE;
  }
  function worldY(lat: number, z: number) {
    const r = (lat * Math.PI) / 180;
    return ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * (1 << z) * TILE;
  }

  // Zoom and origin that fit an exit's points into a W x H window, plus the
  // tiles that view needs. Shared by rendering and next-tile prefetch.
  function computeView(i: number, W: number, H: number) {
    const e = exits[i];
    const pts = [{ lat: e.ll[0], lon: e.ll[1], min: 0 }];
    for (const [, , min, dlat, dlon] of e.p) {
      pts.push({ lat: e.ll[0] + dlat / 1e4, lon: e.ll[1] + dlon / 1e4, min });
    }

    let z = 15;
    for (; z > 11; z--) {
      const xs = pts.map((p) => worldX(p.lon, z));
      const ys = pts.map((p) => worldY(p.lat, z));
      if (Math.max(...xs) - Math.min(...xs) <= W - 52 && Math.max(...ys) - Math.min(...ys) <= H - 52) break;
    }

    const xs = pts.map((p) => worldX(p.lon, z));
    const ys = pts.map((p) => worldY(p.lat, z));
    const originX = (Math.max(...xs) + Math.min(...xs)) / 2 - W / 2;
    const originY = (Math.max(...ys) + Math.min(...ys)) / 2 - H / 2;

    const tiles: { url: string; left: number; top: number }[] = [];
    const maxTile = (1 << z) - 1;
    for (let tx = Math.floor(originX / TILE); tx <= Math.floor((originX + W) / TILE); tx++) {
      for (let ty = Math.max(0, Math.floor(originY / TILE)); ty <= Math.min(maxTile, Math.floor((originY + H) / TILE)); ty++) {
        const wrapped = ((tx % (1 << z)) + (1 << z)) % (1 << z);
        tiles.push({
          url: `https://tile.openstreetmap.org/${z}/${wrapped}/${ty}.png`,
          left: tx * TILE - originX,
          top: ty * TILE - originY,
        });
      }
    }
    return { pts, z, originX, originY, tiles };
  }

  // Warm the next exit's tiles into the browser cache so advancing the
  // drive never flashes an empty map.
  function prefetchTiles(i: number) {
    if (i < 0 || i >= total) return;
    for (const t of computeView(i, mapBox.clientWidth, mapBox.clientHeight).tiles) {
      new Image().src = t.url;
    }
  }

  function renderMap(i: number) {
    const W = mapBox.clientWidth;
    const H = mapBox.clientHeight;
    overlay.setAttribute("viewBox", `0 0 ${W} ${H}`);

    const e = exits[i];
    const { pts, z, originX, originY, tiles } = computeView(i, W, H);

    tilesEl.innerHTML = tiles
      .map((t) => `<img src="${t.url}" alt="" style="left:${t.left}px;top:${t.top}px" decoding="async">`)
      .join("");

    // Overlay: exit dot, connectors, place dots, minute labels.
    const px = (lon: number) => worldX(lon, z) - originX;
    const py = (lat: number) => worldY(lat, z) - originY;
    const x1 = px(e.ll[1]);
    const y1 = py(e.ll[0]);

    // Fan out places that share a location (service plazas put every
    // amenity in one building) so each badge stays visible.
    const raw = pts.slice(1).map((p) => ({ ...p, x: px(p.lon), y: py(p.lat) }));
    const clusters = new Map<string, number[]>();
    raw.forEach((p, idx) => {
      const key = `${Math.round(p.x / 16)},${Math.round(p.y / 16)}`;
      if (!clusters.has(key)) clusters.set(key, []);
      clusters.get(key)!.push(idx);
    });
    for (const members of clusters.values()) {
      if (members.length < 2) continue;
      const mx = members.reduce((s, m) => s + raw[m].x, 0) / members.length;
      const my = members.reduce((s, m) => s + raw[m].y, 0) / members.length;
      members.forEach((m, k) => {
        const a = (k / members.length) * Math.PI * 2 - Math.PI / 2;
        raw[m].x = mx + Math.cos(a) * 14;
        raw[m].y = my + Math.sin(a) * 14;
      });
    }

    let svg = "";
    const labels: { x: number; y: number; anchor: string; text: string; order: number }[] = [];
    raw.forEach((p, idx) => {
      const x2 = p.x;
      const y2 = p.y;
      const dx = x2 - x1;
      const dy = y2 - y1;
      const len = Math.hypot(dx, dy) || 1;
      const cxq = (x1 + x2) / 2 - (dy / len) * len * 0.18;
      const cyq = (y1 + y2) / 2 + (dx / len) * len * 0.18;
      const cat = e.p[idx][1];
      svg += `<path class="drive-conn" data-order="${idx}" d="M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${cxq.toFixed(1)} ${cyq.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}" />`;
      svg += `<g class="drive-poi" data-order="${idx}"><circle class="drive-poi-bg" cx="${x2.toFixed(1)}" cy="${y2.toFixed(1)}" r="8" /><use class="drive-poi-ic" href="${icon(cat)}" x="${(x2 - 5).toFixed(1)}" y="${(y2 - 5).toFixed(1)}" width="10" height="10" /></g>`;
      labels.push({
        x: x2 + (x2 >= x1 ? 12 : -12),
        y: y2 + 3,
        anchor: x2 >= x1 ? "start" : "end",
        text: `${p.min} min`,
        order: idx,
      });
    });

    for (const side of ["start", "end"]) {
      const group = labels.filter((l) => l.anchor === side).sort((a, b) => a.y - b.y);
      for (let g = 1; g < group.length; g++) {
        if (group[g].y - group[g - 1].y < 12) group[g].y = group[g - 1].y + 12;
      }
    }
    for (const l of labels) {
      svg += `<text class="drive-map-min" data-order="${l.order}" x="${l.x.toFixed(1)}" y="${l.y.toFixed(1)}" text-anchor="${l.anchor}">${l.text}</text>`;
    }

    svg += `<circle class="drive-here" cx="${x1.toFixed(1)}" cy="${y1.toFixed(1)}" r="4.5" />`;
    overlay.innerHTML = svg;

    if (!reducedMotion) {
      overlay.querySelectorAll<SVGPathElement>(".drive-conn").forEach((path) => {
        const order = Number(path.dataset.order);
        const length = path.getTotalLength();
        path.style.strokeDasharray = String(length);
        path.style.strokeDashoffset = String(length);
        path.style.animation = `drive-draw 0.38s ease-out ${order * 110}ms forwards`;
      });
      overlay.querySelectorAll<SVGElement>(".drive-poi, .drive-map-min").forEach((el) => {
        const order = Number(el.dataset.order);
        el.style.opacity = "0";
        el.style.animation = `drive-pop 0.2s ease-out ${order * 110 + 300}ms forwards`;
      });
    }
  }

  function render(i: number) {
    const e = exits[i];
    pos.textContent = `${(i + 1).toLocaleString("en-US")} of ${total.toLocaleString("en-US")} exits`;
    exitEl.textContent = exitLabel(e);
    if (e.p.length > 0) {
      services.innerHTML = e.p
        .map(
          ([label, cat, min]) =>
            `<div class="drive-row"><span class="drive-cat"><svg class="drive-ic" aria-hidden="true"><use href="${icon(cat)}" /></svg>${escapeHtml(cat)}</span><span class="drive-place">${escapeHtml(label)}</span><span class="drive-min">${min} min</span></div>`
        )
        .join("");
    } else {
      let ahead = 0;
      for (let j = i + 1; j < total; j++) {
        if (exits[j].p.length > 0) {
          ahead = j - i;
          break;
        }
      }
      services.innerHTML = ahead
        ? `<div class="drive-row drive-none">No scored services here. Next services: ${escapeHtml(exitLabel(exits[i + ahead]).toLowerCase())}, ${ahead} exit${ahead === 1 ? "" : "s"} ahead.</div>`
        : `<div class="drive-row drive-none">No scored services ahead. You have reached the end of the corridor.</div>`;
    }
    renderMap(i);
    prefetchTiles(i + 1);
  }

  // Start in the early middle of the corridor, at an exit rich enough to
  // make a good first card.
  let start = Math.floor(total * 0.28);
  for (let i = start; i < total; i++) {
    if (exits[i].p.length >= 5) {
      start = i;
      break;
    }
  }
  range.value = String(start);
  render(start);

  range.addEventListener("input", () => {
    stopDriving();
    render(Number(range.value));
  });

  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener("resize", () => {
    if (resizeTimer !== null) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => renderMap(Number(range.value)), 150);
  });

  let timer: ReturnType<typeof setInterval> | null = null;

  function startDriving() {
    if (timer !== null) return;
    btn.textContent = "Stop";
    timer = setInterval(() => {
      const next = Number(range.value) + 1;
      if (next >= total) {
        stopDriving();
        return;
      }
      range.value = String(next);
      render(next);
    }, 2400);
  }

  function stopDriving() {
    if (timer !== null) {
      clearInterval(timer);
      timer = null;
      btn.textContent = "Drive";
    }
  }

  btn.addEventListener("click", () => {
    if (timer !== null) stopDriving();
    else startDriving();
  });

  // Drive automatically the first time the widget scrolls into view.
  if (!reducedMotion) {
    let autoStarted = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !autoStarted) {
            autoStarted = true;
            startDriving();
            io.disconnect();
          }
        }
      },
      { threshold: 0.35 }
    );
    io.observe(document.querySelector(".drive")!);
  }

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stopDriving();
  });
</script>
